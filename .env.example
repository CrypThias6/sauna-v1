# Names only. Put the values in Vercel, or in a local .env that is not committed.
# Never prefix a secret with VITE_. Vite copies VITE_ names into the public page.

# Sensor read. A local .env may still call this PIQO_TOKEN; the server accepts that name too.
PIQO_READ_TOKEN=
# Operate token for the Sauna Twin. Leave empty until Tim confirms the API.
PIQO_OPERATE_TOKEN=
PIQO_BASE_URL=https://proxy2.piqo.nz
PIQO_TWIN_ID=25b839a8-6d58-4e62-b187-775a90e881a1
# Optional. Defaults are the Sauna sensor already used on this branch.
PIQO_DEVICE_ID=606273ef-54cd-480a-b7ab-6024be6ed577
PIQO_COMPONENT=sht4x.09c38e29.temperature
PIQO_HUMIDITY_COMPONENT=

# One shared staff password, and the key that signs the session cookie.
STAFF_PASSWORD=
SESSION_SECRET=
# Bearer token for POST /api/tick. cron-job.org sends this. Not a Vercel cron.
CRON_SECRET=

SITE_TZ=Pacific/Auckland
BOOKINGS_SOURCE=mock

# Later, when SimplyBook is wired:
# SIMPLYBOOK_COMPANY=
# SIMPLYBOOK_API_KEY=
# SIMPLYBOOK_SECRET=

# GitHub Pages build leaves this unset (base /sauna-v1/). On Vercel set it to /.
# Vercel also sets VERCEL=1, which uses / when VITE_BASE is unset.
VITE_BASE=/
