# Names only. Put the values in Vercel, or in a local .env that is not committed.
# Never prefix a secret with VITE_. Vite copies VITE_ names into the public page.

# Sensor read. A local .env may still call this PIQO_TOKEN; the server accepts that name too.
PIQO_READ_TOKEN=
PIQO_BASE_URL=https://proxy2.piqo.nz
PIQO_TWIN_ID=25b839a8-6d58-4e62-b187-775a90e881a1
# Optional. Defaults are the Grove SHT4x on the Seeed XIAO, not simulated CO or moisture.
PIQO_DEVICE_ID=606273ef-54cd-480a-b7ab-6024be6ed577
PIQO_COMPONENT=sht4x.09c38e29.temperature
PIQO_HUMIDITY_COMPONENT=sht4x.09c38e29.humidity

# One Piqo Action link per saved Action. Server only. Never put these in VITE_ names.
# POST the link with {"request_id":"<uuid>"}. A missing name is skipped, not fatal.
PIQO_LINK_GLOW_ON=
PIQO_LINK_GLOW_OFF=
PIQO_LINK_OUTDOOR_ON=
PIQO_LINK_OUTDOOR_OFF=
PIQO_LINK_GENTLE_FLASH=
PIQO_LINK_WARNING_FLASH=

# One shared staff password, and the key that signs the session cookie.
STAFF_PASSWORD=
SESSION_SECRET=
# Bearer token for POST /api/tick. cron-job.org sends this. Not a Vercel cron.
CRON_SECRET=

SITE_TZ=Pacific/Auckland
# mock is only for tests. Leave this as simplybook once the names below are set.
BOOKINGS_SOURCE=

# SimplyBook Admin REST. All of these stay on the server.
SIMPLYBOOK_COMPANY=
SIMPLYBOOK_API_KEY=
SIMPLYBOOK_USER_LOGIN=
SIMPLYBOOK_USER_KEY=
SIMPLYBOOK_USER_PASSWORD=
SIMPLYBOOK_WEBHOOK_SECRET=
SIMPLYBOOK_API_URL=https://user-api-v2.simplybook.me

# GitHub Pages build leaves this unset (base /sauna-v1/). On Vercel set it to /.
# Vercel also sets VERCEL=1, which uses / when VITE_BASE is unset.
VITE_BASE=/
